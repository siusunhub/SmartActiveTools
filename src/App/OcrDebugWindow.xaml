<Window x:Class="SmartActiveTools.App.OcrDebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCR Text" Height="440" Width="620"
        Icon="app.ico"
        MinHeight="260" MinWidth="400"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusText" Text="Ready to capture the selected target window."
                   Margin="0,0,0,8" />
        <TextBox x:Name="OcrTextBox" Grid.Row="1" IsReadOnly="True"
                 FontFamily="Consolas" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <CheckBox x:Name="CropTextCheckBox" Content="Crop text" VerticalAlignment="Center"
                      Margin="0,0,12,0" />
            <Button x:Name="OcrAfterDelayButton" Content="OCR after 3 Seconds" Padding="12,6"
                    Margin="0,0,8,0" Click="OnOcrAfterDelay" />
            <Button Content="Close" Padding="18,6" IsCancel="True" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
